{
  "description": "足球经理的推断 · Taro 跨端微信小程序",
  "appid": "touristappid",
  "compileType": "minigame",
  "libVersion": "latest",
  "miniprogramRoot": "./dist/weapp/",
  "projectname": "football-manager-cross-platform",
  "setting": {
    "es6": true,
    "enhance": true,
    "minified": true,
    "postcss": true,
    "urlCheck": false,
    "coverView": true,
    "ignoreUploadUnusedFiles": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "src" },
      { "type": "folder", "value": "config" },
      { "type": "file", "value": "project.private.config.json" }
    ]
  }
}
