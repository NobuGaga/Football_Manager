.hero-eyebrow {
  color: #97a397;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 26rpx;
  font-size: 62rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: -3rpx;
}

.hero-title text {
  display: block;
  color: #c8f55a;
}

.hero-description {
  margin-top: 28rpx;
  color: #9eaa9c;
  font-size: 27rpx;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  margin-top: 36rpx;
  flex-direction: column;
  gap: 18rpx;
}

.model-card {
  margin-top: 42rpx;
  padding: 30rpx;
  background: #121a14;
}

.model-caption {
  color: #718071;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.model-name {
  margin-top: 10rpx;
  font-size: 27rpx;
}

.matrix-heading {
  display: flex;
  margin-top: 38rpx;
  align-items: center;
  justify-content: space-between;
  color: #a8b3a5;
  font-size: 23rpx;
}

.matrix-note {
  color: #6e7b6e;
  font-size: 18rpx;
}

.score-matrix {
  display: grid;
  margin-top: 24rpx;
  padding: 14rpx;
  border: 1rpx solid #2d392e;
  border-radius: 16rpx;
  background: #0b110d;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.matrix-cell {
  height: 48rpx;
  border-radius: 7rpx;
  background: #c8f55a;
}

.matrix-hot {
  box-shadow: 0 0 24rpx #718c35;
}

.model-features {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #293429;
  gap: 34rpx;
}

.model-features > view {
  display: flex;
  align-items: center;
  color: #b5c0b1;
  font-size: 21rpx;
}

.feature-mark {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #c8f55a;
  background: #202b17;
  font-size: 20rpx;
}

.stats-grid {
  display: flex;
  margin-top: 38rpx;
  border-top: 1rpx solid #2a342a;
  border-bottom: 1rpx solid #2a342a;
  flex-wrap: wrap;
}

.stat-card {
  width: 50%;
  padding: 30rpx 16rpx 30rpx 0;
  border-bottom: 1rpx solid #252f26;
}

.stat-card:nth-child(2n) {
  padding-left: 24rpx;
  border-left: 1rpx solid #252f26;
}

.stat-card:nth-last-child(-n+2) {
  border-bottom: 0;
}

.stat-value {
  font-size: 48rpx;
  line-height: 1;
}

.stat-value text {
  margin-left: 8rpx;
  color: #c8f55a;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 21rpx;
}

.stat-label {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 550;
}

.stat-detail {
  margin-top: 8rpx;
  color: #738072;
  font-size: 18rpx;
  line-height: 1.6;
}

.principle-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.principle-card {
  padding: 28rpx;
}

.principle-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.principle-number {
  color: #738071;
  font-size: 19rpx;
}

.principle-mark {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #c8f55a;
  background: #222c18;
  font-size: 22rpx;
}

.principle-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.principle-description {
  margin-top: 12rpx;
  color: #95a192;
  font-size: 24rpx;
  line-height: 1.8;
}

.overview .notice,
.notice {
  margin-top: 34rpx;
}
