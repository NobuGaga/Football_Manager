.first-heading {
  margin-top: 12rpx;
}

.command-card {
  overflow: hidden;
}

.command-tabs {
  display: flex;
  padding: 12rpx;
  border-bottom: 1rpx solid #2a342a;
  background: #0e1510;
  gap: 10rpx;
}

.command-tab {
  min-height: 68rpx;
  padding: 0 12rpx;
  flex: 1;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  color: #7f8b7c;
  font-size: 22rpx;
  line-height: 68rpx;
  text-align: center;
}

.command-active {
  border-color: #34402f;
  color: #eef3e9;
  background: #1b241c;
}

.command-content {
  padding: 28rpx;
}

.command-badge {
  display: inline-flex;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #c8f55a;
  background: #222d17;
  font-size: 19rpx;
}

.command-title {
  margin-top: 22rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.55;
}

.command-description {
  margin-top: 12rpx;
  color: #8e9a8b;
  font-size: 22rpx;
  line-height: 1.75;
}

.terminal-window {
  margin-top: 26rpx;
  overflow: hidden;
  border: 1rpx solid #303a30;
  border-radius: 16rpx;
  background: #090e0b;
}

.terminal-head {
  display: flex;
  height: 64rpx;
  padding: 0 20rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #273027;
  color: #647160;
  font-size: 17rpx;
}

.copy-button {
  padding: 8rpx 12rpx;
  color: #c8f55a;
  font-size: 20rpx;
}

.terminal-code {
  display: block;
  padding: 24rpx 20rpx;
  overflow-wrap: anywhere;
  color: #d6e2d0;
  font-size: 20rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.command-notice {
  margin-top: 22rpx;
}

.compact-heading {
  margin-bottom: 24rpx;
}

.small-title {
  font-size: 34rpx;
}

.runbook-card {
  padding: 28rpx;
}

.runbook-step {
  position: relative;
  display: flex;
  min-height: 64rpx;
  align-items: flex-start;
}

.step-number {
  position: relative;
  z-index: 1;
  display: flex;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #3b4934;
  border-radius: 50%;
  color: #c8f55a;
  background: #121914;
  font-size: 17rpx;
}

.step-line {
  position: absolute;
  top: 44rpx;
  bottom: 0;
  left: 21rpx;
  width: 1rpx;
  background: #33402f;
}

.runbook-step:last-child .step-line {
  display: none;
}

.step-text {
  padding-top: 6rpx;
  color: #aab5a5;
  font-size: 23rpx;
}

.safety-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.safety-card {
  display: flex;
  padding: 26rpx;
  align-items: flex-start;
}

.safety-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #c8f55a;
  background: #222d17;
  font-size: 19rpx;
}

.safety-copy {
  display: flex;
  flex-direction: column;
}

.safety-title {
  font-size: 26rpx;
  font-weight: 550;
}

.safety-description {
  margin-top: 9rpx;
  color: #859182;
  font-size: 22rpx;
  line-height: 1.75;
}
