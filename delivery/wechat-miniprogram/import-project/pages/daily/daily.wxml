<view class="page">
  <view class="section-heading daily-heading">
    <text class="section-kicker mono">DAILY PROBABILITY REPORT</text>
    <text class="section-title">每日推断</text>
    <text class="section-description">{{reportDate}} · 共 {{matchCount}} 场 · 由 Kimi Claw 随每日任务打包更新</text>
  </view>

  <view class="notice">
    <view class="notice-mark">!</view>
    <view class="notice-text">{{disclaimer}} 数据完整度较低时仅作弱参考。</view>
  </view>

  <view wx:if="{{matches.length}}" class="match-list">
    <view wx:for="{{matches}}" wx:key="fixtureKey" class="match-card card">
      <view class="match-topline">
        <text class="match-code mono">{{item.matchCode}}</text>
        <text class="match-time mono">{{item.startTimeText}}</text>
      </view>
      <view class="match-league">{{item.league}}</view>
      <view class="match-teams">{{item.homeTeam}}<text>VS</text>{{item.awayTeam}}</view>

      <view class="tendency-row">
        <text>最高概率倾向</text>
        <text class="tendency-value">{{item.tendency}}</text>
      </view>
      <view class="probability-grid">
        <view><text>主胜</text><text class="mono">{{item.homePercent}}</text></view>
        <view><text>平局</text><text class="mono">{{item.drawPercent}}</text></view>
        <view><text>客胜</text><text class="mono">{{item.awayPercent}}</text></view>
      </view>

      <view class="score-row">
        <text>比分参考</text>
        <text wx:for="{{item.topScores}}" wx:for-item="score" wx:key="score" class="score-item mono">{{score.score}} · {{score.probabilityText}}</text>
      </view>
      <view class="data-row">
        <text>完整度 {{item.completenessText}}</text>
        <text>{{item.methodText}}</text>
      </view>
      <view class="risk-text">{{item.primaryRisk}}<text wx:if="{{item.remainingRiskCount}}"> 等 {{item.remainingRiskCount + 1}} 项风险</text></view>
    </view>
  </view>

  <view wx:else class="empty-card card">暂无可展示的每日推断，请先运行每日任务。</view>
  <view class="footer-note">数据生成于 {{generatedAt}}<br/>本页面为打包时的报告快照，不实时连接数据库。</view>
</view>
