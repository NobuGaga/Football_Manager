page {
  min-height: 100%;
  color: #eef3e9;
  background: #0b100d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
scroll-view,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: inherit;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
  text-align: left;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 90% 0%, #172318 0%, #0b100d 38%);
}

.mono {
  font-family: "SFMono-Regular", Consolas, monospace;
}

.muted {
  color: #97a397;
}

.accent {
  color: #c8f55a;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.brand-mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #152008;
  background: #c8f55a;
  font-size: 26rpx;
  font-weight: 800;
}

.brand-copy {
  display: flex;
  margin-left: 20rpx;
  flex: 1;
  flex-direction: column;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #718071;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.baseline-badge,
.outline-badge {
  padding: 8rpx 14rpx;
  border: 1rpx solid #344033;
  border-radius: 30rpx;
  color: #a2aea0;
  background: #121914;
  font-size: 19rpx;
}

.section-heading {
  margin: 64rpx 0 30rpx;
}

.section-kicker {
  display: block;
  margin-bottom: 14rpx;
  color: #c8f55a;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.section-description {
  display: block;
  margin-top: 14rpx;
  color: #859385;
  font-size: 24rpx;
  line-height: 1.75;
}

.card {
  border: 1rpx solid #283229;
  border-radius: 24rpx;
  background: #121914;
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #758273;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 88rpx;
  padding: 0 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 550;
}

.primary-button {
  color: #152008;
  background: #c8f55a;
}

.secondary-button {
  border: 1rpx solid #303b30;
  color: #c1cbbd;
  background: #121914;
}

.button-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 14rpx;
  border: 1rpx solid #2d382e;
  border-radius: 10rpx;
  color: #a5b0a1;
  background: #0e1510;
  font-size: 20rpx;
}

.notice {
  display: flex;
  padding: 24rpx;
  align-items: flex-start;
  border: 1rpx solid #3b482c;
  border-radius: 18rpx;
  background: #171f13;
}

.notice-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #152008;
  background: #c8f55a;
  font-size: 22rpx;
  font-weight: 700;
}

.notice-text {
  color: #a8b49e;
  font-size: 23rpx;
  line-height: 1.75;
}

.footer-note {
  margin-top: 56rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #263026;
  color: #6f7d70;
  font-size: 21rpx;
  line-height: 1.8;
}
