<view class="page">
  <view class="section-heading first-heading">
    <text class="section-kicker mono">04 / DAILY AUTOMATION</text>
    <text class="section-title">每天一条安全、完整的执行链</text>
    <text class="section-description">Kimi Claw 定时执行并推送预测策略，GitHub 仅保存项目版本。</text>
  </view>

  <view class="command-card card">
    <view class="command-tabs">
      <button wx:for="{{commandModes}}" wx:key="id" class="command-tab {{commandMode === item.id ? 'command-active' : ''}}" data-mode="{{item.id}}" bindtap="selectCommand">{{item.label}}</button>
    </view>
    <view class="command-content">
      <view class="command-badge">{{currentCommand.badge}}</view>
      <view class="command-title">{{currentCommand.title}}</view>
      <view class="command-description">{{currentCommand.description}}</view>
      <view class="terminal-window">
        <view class="terminal-head"><text class="mono">TERMINAL</text><button class="copy-button" bindtap="copyCommand">复制</button></view>
        <text class="terminal-code mono" user-select>{{currentCommand.command}}</text>
      </view>
    </view>
  </view>

  <view class="notice command-notice">
    <view class="notice-mark">!</view>
    <view class="notice-text">正式任务要求 Git 工作区干净；关联失败时不提交半成品。小程序只展示命令，不会在你的设备上执行。</view>
  </view>

  <view class="section-heading compact-heading">
    <text class="section-kicker mono">DAILY RUNBOOK</text>
    <text class="section-title small-title">每日执行顺序</text>
  </view>

  <view class="runbook-card card">
    <view wx:for="{{automationSteps}}" wx:key="*this" class="runbook-step">
      <view class="step-number mono">{{index + 1}}</view>
      <view class="step-line"></view>
      <text class="step-text">{{item}}</text>
    </view>
  </view>

  <view class="section-heading compact-heading">
    <text class="section-kicker mono">SAFETY BOUNDARIES</text>
    <text class="section-title small-title">自动化安全边界</text>
  </view>

  <view class="safety-list">
    <view wx:for="{{safetyRules}}" wx:key="title" class="safety-card card">
      <view class="safety-mark">{{item.mark}}</view>
      <view class="safety-copy"><text class="safety-title">{{item.title}}</text><text class="safety-description">{{item.description}}</text></view>
    </view>
  </view>
</view>
