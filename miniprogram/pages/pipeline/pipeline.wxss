.first-heading {
  margin-top: 12rpx;
}

.flow-scroll {
  width: calc(100% + 30rpx);
  margin-right: -30rpx;
  white-space: nowrap;
}

.flow-tabs {
  display: inline-flex;
  padding: 8rpx 30rpx 18rpx 0;
  gap: 14rpx;
}

.flow-tab {
  position: relative;
  display: inline-flex;
  width: 154rpx;
  min-height: 168rpx;
  padding: 22rpx 14rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid #293429;
  border-radius: 18rpx;
  color: #869284;
  background: #111812;
}

.flow-active {
  border-color: #c8f55a;
  color: #eef3e9;
  background: #1c2716;
}

.flow-number {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  color: #637060;
  font-size: 16rpx;
}

.flow-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin-top: 12rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #c8f55a;
  background: #243019;
  font-size: 24rpx;
}

.flow-name {
  margin-top: 14rpx;
  font-size: 22rpx;
}

.flow-detail {
  margin-top: 18rpx;
  padding: 32rpx;
}

.detail-kicker {
  color: #c8f55a;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.detail-title {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.45;
}

.detail-lead {
  margin-top: 22rpx;
  color: #d6ded1;
  font-size: 26rpx;
  line-height: 1.8;
}

.detail-copy {
  margin-top: 18rpx;
  color: #8f9c8c;
  font-size: 23rpx;
  line-height: 1.85;
}

.flow-progress {
  display: flex;
  margin-top: 30rpx;
  align-items: center;
  gap: 18rpx;
  color: #748171;
  font-size: 18rpx;
}

.progress-track {
  height: 6rpx;
  overflow: hidden;
  flex: 1;
  border-radius: 6rpx;
  background: #293329;
}

.progress-value {
  height: 100%;
  border-radius: 6rpx;
  background: #c8f55a;
  transition: width 0.25s ease;
}

.io-card {
  margin-top: 18rpx;
  padding: 26rpx;
  background: #0e1510;
}

.io-block {
  display: flex;
  padding: 24rpx;
  flex-direction: column;
  border: 1rpx solid #2b362c;
  border-radius: 16rpx;
  background: #131b14;
}

.io-label {
  color: #71806f;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.io-value {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  font-size: 23rpx;
  line-height: 1.7;
}

.io-output {
  border-color: #556934;
}

.io-output .io-label {
  color: #c8f55a;
}

.io-arrow {
  height: 44rpx;
  color: #6f7c6d;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
}

.io-safe {
  margin-top: 20rpx;
  color: #7f8e79;
  font-size: 20rpx;
  text-align: center;
}

.next-button {
  margin-top: 22rpx;
}

.complete-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #526632;
  border-radius: 16rpx;
  color: #c8f55a;
  background: #192214;
  font-size: 24rpx;
  text-align: center;
}

.tables-card {
  display: flex;
  padding: 24rpx;
  flex-wrap: wrap;
  gap: 14rpx;
}

.table-tag {
  padding: 12rpx 14rpx;
  border: 1rpx solid #2f3a30;
  border-radius: 10rpx;
  color: #a7b2a2;
  background: #0d140f;
  font-size: 19rpx;
}
