.first-heading {
  margin-top: 12rpx;
}

.formula-card {
  padding: 32rpx;
  border-radius: 24rpx;
  color: #152008;
  background: #c8f55a;
}

.formula-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #536630;
  font-size: 17rpx;
}

.formula-title {
  margin-top: 30rpx;
  font-size: 38rpx;
  font-weight: 650;
}

.formula-description {
  margin-top: 14rpx;
  color: #415020;
  font-size: 24rpx;
  line-height: 1.8;
}

.formula-box {
  display: flex;
  margin-top: 28rpx;
  padding: 28rpx;
  flex-direction: column;
  border-radius: 18rpx;
  color: #edf5df;
  background: #142009;
}

.formula-caption {
  color: #879776;
  font-size: 18rpx;
}

.formula-main {
  margin-top: 14rpx;
  color: #c8f55a;
  font-size: 29rpx;
}

.formula-equation {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  font-size: 21rpx;
  line-height: 1.8;
}

.correction-title {
  margin-top: 26rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.correction-copy {
  margin-top: 8rpx;
  color: #465523;
  font-size: 21rpx;
  line-height: 1.75;
}

.formula-tags {
  display: flex;
  margin-top: 24rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.formula-tags text {
  padding: 8rpx 12rpx;
  border: 1rpx solid #8ea840;
  border-radius: 9rpx;
  font-size: 19rpx;
}

.compact-heading {
  margin-bottom: 24rpx;
}

.small-title {
  font-size: 34rpx;
}

.priority-card {
  padding: 8rpx 26rpx;
}

.priority-item {
  display: flex;
  padding: 24rpx 0;
  align-items: center;
  border-bottom: 1rpx solid #2a342a;
}

.priority-item:last-child {
  border-bottom: 0;
}

.priority-number {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #3a4734;
  border-radius: 50%;
  color: #c8f55a;
  font-size: 18rpx;
}

.priority-copy {
  display: flex;
  flex-direction: column;
}

.priority-title {
  font-size: 25rpx;
  font-weight: 550;
}

.priority-detail {
  margin-top: 7rpx;
  color: #7f8c7c;
  font-size: 21rpx;
  line-height: 1.65;
}

.boundary-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.boundary-kicker {
  color: #c8f55a;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.boundary-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.boundary-copy {
  margin-top: 10rpx;
  color: #849181;
  font-size: 22rpx;
}

.equation-button {
  display: flex;
  margin-top: 24rpx;
  padding: 22rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #34402f;
  border-radius: 14rpx;
  color: #c8f55a;
  background: #090e0b;
  font-size: 18rpx;
  gap: 8rpx;
}

.equation-button .mono {
  color: #d4dfcf;
  font-size: 17rpx;
}

.equation-hint {
  margin-top: 12rpx;
  color: #63705f;
  font-size: 18rpx;
  text-align: right;
}

.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric-card {
  display: flex;
  width: calc(50% - 8rpx);
  min-height: 176rpx;
  padding: 22rpx;
  flex-direction: column;
}

.metric-number {
  color: #657261;
  font-size: 17rpx;
}

.metric-name {
  margin-top: auto;
  padding-top: 22rpx;
  font-size: 24rpx;
  font-weight: 550;
}

.metric-label {
  margin-top: 6rpx;
  color: #778474;
  font-size: 19rpx;
}
