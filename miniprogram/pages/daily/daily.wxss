.daily-heading {
  margin-top: 12rpx;
}

.match-list {
  display: flex;
  margin-top: 30rpx;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  padding: 28rpx;
}

.match-topline,
.data-row,
.tendency-row,
.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-code {
  color: #c8f55a;
  font-size: 23rpx;
}

.match-time {
  color: #7f8c7c;
  font-size: 19rpx;
}

.match-league {
  margin-top: 20rpx;
  color: #8e9b8b;
  font-size: 22rpx;
}

.match-teams {
  display: flex;
  margin-top: 8rpx;
  align-items: center;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
  gap: 14rpx;
}

.match-teams text {
  color: #667361;
  font-size: 18rpx;
  font-weight: 400;
}

.tendency-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #2a342a;
  color: #8e9b8b;
  font-size: 22rpx;
}

.tendency-value {
  color: #c8f55a;
  font-size: 26rpx;
  font-weight: 600;
}

.probability-grid {
  display: grid;
  margin-top: 18rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.probability-grid view {
  display: flex;
  padding: 16rpx 8rpx;
  flex-direction: column;
  align-items: center;
  border-radius: 12rpx;
  color: #8e9b8b;
  background: #0c120e;
  font-size: 20rpx;
  gap: 5rpx;
}

.probability-grid .mono {
  color: #eef3e9;
  font-size: 25rpx;
}

.score-row {
  margin-top: 20rpx;
  align-items: flex-start;
  color: #7f8c7c;
  font-size: 20rpx;
  gap: 10rpx;
}

.score-item {
  color: #c1cbbd;
}

.data-row {
  margin-top: 20rpx;
  color: #8e9b8b;
  font-size: 20rpx;
}

.risk-text {
  margin-top: 14rpx;
  color: #b7a77b;
  font-size: 20rpx;
  line-height: 1.7;
}

.empty-card {
  margin-top: 30rpx;
  padding: 40rpx;
  color: #8e9b8b;
  text-align: center;
}
