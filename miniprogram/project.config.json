{
  "description": "足球经理的推断 · 工程信息微信小程序",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "latest",
  "miniprogramRoot": "./",
  "projectname": "football-manager-project-hub",
  "setting": {
    "es6": true,
    "enhance": true,
    "minified": true,
    "postcss": true,
    "urlCheck": false,
    "coverView": true,
    "ignoreUploadUnusedFiles": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "scripts" },
      { "type": "file", "value": "project.private.config.json" }
    ]
  }
}
